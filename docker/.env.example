# 复制为 docker/.env 后填写。不要提交。

# ---- 本 compose 自带的 MySQL 8（不要再用宝塔那份）----
# 容器互访固定 mysql:3306。宿主机/Navicat 走这个口，避开宝塔 3306/23406。
# 外网要连：宝塔「安全」+ 云安全组都放行这个口（建议只放行你自己的 IP）。
MYSQL_PUBLISH_PORT=23306
MYSQL_DATABASE=one-agbot
MYSQL_PASSWORD=改成你的库密码

# ---- 本 compose 自带的 Redis ----
REDIS_PASSWORD=改成一段随机密码

# ---- SnailAI ----
SNAIL_AI_TOKEN=改成你的 token
SNAIL_AI_CRYPTO_KEY=0123456789abcdef0123456789abcdef
SNAIL_AI_CRYPTO_IV=fedcba9876543210fedcba9876543210

# ---- 对外端口（避开宿主机已被占的口）----
BOOT_PORT=18088
SNAILAI_HTTP_PORT=18900
