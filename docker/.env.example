# 复制为 docker/.env 后填写。不要提交、不要用宝塔「备份网站」把这个文件传到别人机器。

# ---- 已有 MySQL（宿主机 23406）----
# 容器走 host.docker.internal 访问宿主机。
# 连不上时：宝塔里把 MySQL 监听改成 0.0.0.0，并给账号授权跨网段（见下方注释）。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=23406
MYSQL_DATABASE=one-agbot
MYSQL_USERNAME=root
MYSQL_PASSWORD=改成你的库密码

# ---- 本 compose 自带的 Redis ----
REDIS_PASSWORD=改成一段随机密码

# ---- SnailAI ----
SNAIL_AI_TOKEN=改成你的 token
# 32 位 hex，生产务必改掉默认值
SNAIL_AI_CRYPTO_KEY=0123456789abcdef0123456789abcdef
SNAIL_AI_CRYPTO_IV=fedcba9876543210fedcba9876543210

# ---- 对外端口（宝塔安全组 / 防火墙也要放行）----
BOOT_PORT=8088
SNAILAI_HTTP_PORT=8900

# MySQL 账号若只允许 localhost，容器连不上。在宝塔「数据库」执行：
# CREATE USER IF NOT EXISTS 'agbot'@'%' IDENTIFIED BY '同一密码';
# GRANT ALL ON `one-agbot`.* TO 'agbot'@'%';
# FLUSH PRIVILEGES;
# 然后把 MYSQL_USERNAME 改成 agbot
